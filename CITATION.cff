    given-names: Giulio
    email: giulio.fontanella@gssi.it
    affiliation: "Gran Sasso Science Institute (GSSI) and INFN Laboratori Nazionali del Gran Sasso"
license: MIT
repository-code: "https://github.com/Giugiolo0/leo_eclipse"
keywords:
  - astrodynamics
  - eclipse
  - beta angle
  - low Earth orbit
  - mission analysis
